    "designDecisionSummary": "Apple skeleton + health temperature. Light mode default with dark mode support. Apple Design Library tokens (DM Sans, 1.2rem radius, whisper-light shadows) with health module colors mapped to chart tokens: Home=chart-1(green), Advisor=chart-2(blue), Mind=chart-5(purple), Sleep=chart-4(indigo), Record=chart-3(orange), Profile=muted-foreground(neutral). All emojis replaced with Lucide line icons. Android-first: 375px base width, 360/412px breakpoints, 48dp touch targets, no backdrop-filter (solid color + shadow), dvh for popups, inputmode for numeric fields, Roboto font fallback.",
    "componentIndexSummary": [
      {"slug": "button", "name": "Button", "category": "actions", "variantCount": 6, "summary": "Capsule-shaped actions with restrained Apple-inspired hierarchy."},
      {"slug": "card", "name": "Card", "category": "surfaces", "variantCount": 5, "summary": "Quiet containers defined by border and spacing, not decoration."},
      {"slug": "input", "name": "Input", "category": "forms", "variantCount": 4, "summary": "Simple rounded inputs with readable placeholder contrast and visible focus."},
      {"slug": "navigation", "name": "Navigation", "category": "navigation", "variantCount": 5, "summary": "Apple-store-like navigation with top bar and secondary rails."},
      {"slug": "product-grid", "name": "Product Grid", "category": "commerce", "variantCount": 4, "summary": "Four-column merchandising matrix with editorial spacing."},
      {"slug": "comparison-table", "name": "Comparison Table", "category": "data-display", "variantCount": 3, "summary": "Model comparison cards with calm visual structure."}
